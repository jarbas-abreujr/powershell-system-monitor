    },
    "Teams": {
      "Enabled": false,
      "WebhookUrl": "https://example.webhook.office.com/replace-me"
    },
    "Discord": {
      "Enabled": false,
      "WebhookUrl": "https://discord.com/api/webhooks/replace-me"
    }
