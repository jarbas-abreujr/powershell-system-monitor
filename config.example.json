{
  "CheckInterval": 5,
  "Thresholds": {
    "CPU": {
      "Warning": 75,
      "Critical": 90
    },
    "Memory": {
      "Warning": 75,
      "Critical": 90
    },
    "Disk": {
      "Warning": 80,
      "Critical": 90
    }
  },
  "DiskPath": "C:\\",
